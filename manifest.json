{
  "manifest_version": 3,
  "name": "Devoted — Distraction Blocker",
  "short_name": "Devoted",
  "version": "1.0.0",
  "description": "Block Facebook, YouTube, Twitter/X, Instagram, or any site you choose, so you can actually get things done.",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Devoted",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.css",
        "blocked.js",
        "fonts.css",
        "fonts/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
